# Codigo de Pagina Loging + css


<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Login HDA</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="CSS/ejercicio16.css" rel="stylesheet">

</head>

<body>

    <div class="navbar-hda">
      <div class="hda-logo">
        <img src="Imagenes/HDA.jpg" alt="Logo pequeño">
        <span class="title">HDA</span>
      </div>
    </div>
  
    <div class="main-content">
      <img src="Imagenes/HDA.jpg" alt="Logo central">
      <h2>Bienvenida a HDA</h2>
      <p><em>“Ayudándote a florecer cada día”</em></p> <!-- 🎯 Slogan aquí -->
  
      <form class="form-login" onsubmit="login(event)">
        <div class="mb-3">
          <input type="email" class="form-control" placeholder="Correo electrónico" required>
        </div>
        <div class="mb-3">
          <input type="password" class="form-control" placeholder="Contraseña" required>
        </div>
        <button type="submit" class="btn btn-login">Entrar</button>
      </form>
    </div>
  
    <script>
      function login(event) {
        event.preventDefault();
        window.location.href = "Inicio.html";
      }
    </script>
  
  </body>
  
</html>


CSS

body {
  background-color: #fff;
  font-family: Arial, sans-serif;
}

.navbar-hda {
  background-color: #e9a8c3; /* Rosa palo */
  padding: 10px 20px;
  display: flex;
  align-items: center;
}

.navbar-hda .hda-logo {
  display: flex;
  align-items: center;
  gap: 10px;
}


.navbar-hda img {
  height: 40px;
}

.navbar-hda .title {
  font-weight: bold;
  font-size: 1.5rem;
  color: white;
}

.main-content {
  text-align: center;
  margin-top: 60px;
}

.main-content img {
  width: 150px;
  margin-bottom: 20px;
}

.form-login {
  max-width: 300px;
  margin: 0 auto;
  background-color: #fce4ec;
  padding: 20px;
  border-radius: 15px;
  box-shadow: 0px 5px 10px rgba(0,0,0,0.1);
}

.btn-login {
  background-color: #e9a8c3;
  border: none;
  color: white;
  width: 100%;
}

.btn-login:hover {
  background-color: #d48aad;
}

